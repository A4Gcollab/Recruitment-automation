# Production env for the Vultr VPS Docker stack. Copy to `.env.production` on the
# server and fill in real values. NEVER commit the filled-in file. Loaded both by
# docker compose (for ${...} substitution) and as the app container's env_file.
# See DEPLOYMENT.md §7.

# ---- Database (Postgres runs in the 'db' container; host = service name 'db') ----
# Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgres://postgres:change-me-to-a-strong-password@db:5432/a4g_prod

# ---- App / domain ----
# NEXTAUTH_URL is the only one the app reads; it must be your public HTTPS URL.
# (The domain itself is configured in the nginx vhost + certbot, not here.)
NEXTAUTH_URL=https://RecSup.omysha.org
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# Required when self-hosting behind a reverse proxy (nginx). Without it NextAuth v5
# rejects requests with "UntrustedHost" and login returns a Server-error page.
AUTH_TRUST_HOST=true

# ---- Admin login ----
ADMIN_EMAIL=a4gcollab@gmail.com
# bcrypt hash of the admin password (escape any $ as \$ is NOT needed in this
# file — only in shell-sourced .env.local). Generate with a bcrypt tool.
ADMIN_PASSWORD_HASH=

# ---- Gmail SMTP (email sending) ----
GMAIL_USER=hr.omysha@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SENDER_NAME=Omysha Foundation — HR Team

# ---- Google service account (Sheets API) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=a4g-sheets@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIB...\n-----END PRIVATE KEY-----\n"

# ---- Sending controls ----
SENDING_WINDOW_START_IST=9
SENDING_WINDOW_END_IST=18
HOURLY_SEND_CAP=20
SEND_DELAY_MIN_SECONDS=30
SEND_DELAY_MAX_SECONDS=60
KILL_SWITCH_EMAIL=false

# ---- Cron (system crontab sends this as a Bearer token) ----
# Generate with:  openssl rand -hex 24
CRON_SECRET=
