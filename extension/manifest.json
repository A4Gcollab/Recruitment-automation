{
  "manifest_version": 3,
  "name": "A4G LinkedIn Q&A Sync",
  "version": "1.0.0",
  "description": "Captures LinkedIn screening question answers and syncs them directly to the A4G recruitment dashboard.",

  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/hiring/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/hiring/jobs/*/applicants*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "A4G LinkedIn Q&A Sync"
  },

  "options_page": "options.html"
}
