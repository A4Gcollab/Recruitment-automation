{
  "manifest_version": 3,
  "name": "A4G LinkedIn Tools",
  "version": "1.1.0",
  "description": "Two tools for the A4G LinkedIn hiring workflow: (1) export filtered applicants to CSV, (2) capture screening Q&A answers and sync to the recruitment dashboard.",

  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/hiring/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/hiring/jobs/*/applicants*"],
      "js": ["exporter.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "A4G LinkedIn Tools"
  },

  "options_page": "options.html"
}
